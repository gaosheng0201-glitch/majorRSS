{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MajorRSS",
  "version": "0.1.0",
  "identifier": "com.majorss.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "cd .. && python build_backend.py && cd desktop && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MajorRSS",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:5173 http://127.0.0.1:8765 ws://127.0.0.1:8765; img-src 'self' https://*.google.com data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "backend-bundle/**/*"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
