/.env
/.venv
/ARCHITECTURE.md
/DEVELOPMENT.md
/MAINTENANCE.md

# Python
__pycache__/
*.py[cod]
*$py.class

# Databases
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# PyInstaller build artifacts
build/
dist/
*.spec.bak

# Tauri sidecar binaries for all platforms (rebuild via build_backend.py)
desktop/src-tauri/bin/backend-sidecar-*

# Sidecar debug output
sidecar_stderr.txt
sidecar_stdout.txt

# Auth Cookies & Config (SENSITIVE)
*_cookies.json
*_cookies.dat
config.dat

# Temporary & Test Scripts
add_interval_i18n.py
create_new_tables.py
fix_*.py
patch_*.py
refactor_*.py
remove_*.py
replace_*.py
test_*.py
update_i18n*.py
migrate_*.py

# Runtime logs (dev mode writes to repo root)
logs/

# Python bytecode
__pycache__/
*.pyc

# macOS + local IDE config
.DS_Store
.claude/settings.local.json

# Local secrets (dev-mode app data in repo root)
.enckey
config.dat
*_cookies.dat
*_cookies.json
major_rss.db

# but DO track the real test suite
!tests/
!tests/**
# ...except its bytecode cache (the !tests/** above would otherwise re-include it)
tests/__pycache__/

# R7 generated publish artifacts (runtime output; sample stays tracked)
site/data/digest.json
site/data/feed.xml
